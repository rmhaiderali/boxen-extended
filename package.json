{
  "name": "boxen-extended",
  "version": "0.2.1",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "scripts": {
    "prepack": "npm i && npm run build",
    "build": "tsdown && prettier dist --write --ignore-path /dev/null",
    "test:node": "node tests/node/index.js",
    "test:web": "node tests/web/utils/transform-to-web-module.js && cp tests/web/index.html dist-web && npx serve dist-web",
    "test:upstream": "sh tests/upstream-compatibility.sh"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rmhaiderali/boxen-extended.git"
  },
  "dependencies": {
    "ansi-regex": "^6.2.2",
    "boxen": "^8.0.1",
    "node-inspect-extracted": "^3.3.2"
  },
  "devDependencies": {
    "parse-imports": "^3.0.0",
    "prettier": "^3.8.1",
    "tsdown": "^0.21.7",
    "typescript": "^6.0.2"
  },
  "prettier": {
    "semi": false
  }
}
