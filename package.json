{
  "name": "boxen-extended",
  "version": "0.2.2",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "scripts": {
    "prepack": "npm i && npm run build",
    "build": "tsdown && prettier dist --write --ignore-path /dev/null",
    "test:node": "sh tests/node/test.sh",
    "test:web": "sh tests/web/test.sh",
    "test:upstream": "sh tests/upstream-compatibility.sh",
    "update:upstream": "git submodule update --remote boxen"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rmhaiderali/boxen-extended.git"
  },
  "dependencies": {
    "ansi-regex": "^6.2.2",
    "boxen": "^8.0.1",
    "node-inspect-extracted": "^3.3.2"
  },
  "devDependencies": {
    "parse-imports": "^3.0.0",
    "prettier": "^3.8.1",
    "serve-static-cli": "github:rmhaiderali/serve-static-cli",
    "tsdown": "^0.21.7",
    "typescript": "^6.0.2"
  },
  "prettier": {
    "semi": false
  }
}
